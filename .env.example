SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Mailing list only. Keep this on Doppler (fzlrhmjdjjzcgstaeblu), which holds
# marketing_contacts. Do not point it at VisaPassage (eujmomonscnlmwcbkbfy)
# or at the Business OS project.
NEXT_PUBLIC_SUPABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=

# Business OS only, after the reset and the later SQL files succeed.
# Self-hosted Supabase stack on the Azure core-db VM: https://db.simnetiq.com
# Do not put secret values in this file.
BUSINESS_OS_SUPABASE_URL=
BUSINESS_OS_SUPABASE_PUBLISHABLE_KEY=
BUSINESS_OS_SUPABASE_SECRET_KEY=
BUSINESS_OS_TELEGRAM_BOT_TOKEN=
BUSINESS_OS_TELEGRAM_BOT_ID=
BUSINESS_OS_TELEGRAM_WEBHOOK_SECRET=
BUSINESS_OS_TELEGRAM_SESSION_BROKER=
BUSINESS_OS_JOB_SECRET=
# Bearer token for the Files MCP server (mcp/business-os-files). Prefer a dedicated secret.
BUSINESS_OS_MCP_TOKEN=
# Optional UUID of the membership user document RPCs run as (defaults to first owner).
BUSINESS_OS_MCP_ACTOR_ID=
# Source export secrets are named by each connection's secret_reference.
# Examples: BUSINESS_OS_SOURCE_DOPPLER_PRODUCTION, BUSINESS_OS_SOURCE_SMSCODE_PRODUCTION.
# The systemd timers on the core-apps VM send BUSINESS_OS_JOB_SECRET as a Bearer token to the tick routes.
# AES-256-GCM key for stored provider refresh tokens: `openssl rand -base64 32`.
BUSINESS_OS_TOKEN_KEY=
# Revolut Business API (read-only). Private key is the PEM matching the certificate
# uploaded in Revolut Business › Settings › APIs; "\n" escapes are accepted.
REVOLUT_CLIENT_ID=
REVOLUT_PRIVATE_KEY=
REVOLUT_REDIRECT_URI=
# "sandbox" for Revolut's sandbox; anything else means production.
REVOLUT_ENVIRONMENT=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Public pages only, loaded after the visitor
# accepts in the cookie banner; leave empty to disable analytics and the banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
